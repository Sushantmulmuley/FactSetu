  "general": {
    "statement_download": {
      "value": "You can get a capital-gains statement for HDFC Mutual Fund investments in three ways: (1) through HDFC Mutual Fund's own website using your PAN/registered email, (2) through your RTA — CAMS or KFintech — using your PAN and registered email, or (3) through the platform/distributor you invested via. Statements are usually available after the financial year closes.",
      "source": "https://www.hdfcfund.com/learn/blog/how-get-capital-gain-statement-mutual-fund-schemes-india"
    },
    "riskometer_meaning": {
      "value": "The riskometer is a mandatory SEBI-prescribed 6-level risk gauge (Low, Low to Moderate, Moderate, Moderately High, High, Very High) shown on every scheme document so investors can see the scheme's risk level at a glance before investing.",
      "source": "https://investor.sebi.gov.in/riskometer.html"
    }
  }
